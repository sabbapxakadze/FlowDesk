NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Postgres, dedicated least-privilege role (not the postgres superuser)
# — see docs/adr and CLAUDE.md. Create the role/db yourself locally; this
# file documents the shape, never a real credential.
DATABASE_URL=postgresql://flowdesk:<password>@localhost:5432/flowdesk_dev

# Only read by the API's test setup (apps/api/src/db/test-setup.ts), never
# by the running app. Separate database so tests never touch dev data.
TEST_DATABASE_URL=postgresql://flowdesk:<password>@localhost:5432/flowdesk_test

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Postgres, dedicated least-privilege role (not the postgres superuser)
# — see docs/adr and CLAUDE.md. Create the role/db yourself locally; this
# file documents the shape, never a real credential.
DATABASE_URL=postgresql://flowdesk:<password>@localhost:5432/flowdesk_dev

# Only read by the API's test setup (apps/api/src/db/test-setup.ts), never
# by the running app. Separate database so tests never touch dev data.
TEST_DATABASE_URL=postgresql://flowdesk:<password>@localhost:5432/flowdesk_test

# Signs every access token — anyone with this can forge a valid login.
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<at least 32 random characters>

# Sign up at resend.com, create an API key. Their sandbox sends to your
# own account email with no domain verification needed — fine for local dev.
RESEND_API_KEY=<your resend api key>
EMAIL_FROM=onboarding@resend.dev
# The frontend's origin — verification/reset emails link back to the web
# app, not the API.
APP_URL=http://localhost:5173

# Local disk storage for attachments (Phase 7 slice 4) — real S3 is a
# later phase; this stays a plain relative path until then.
UPLOADS_DIR=./uploads
# Signs every attachment download token — anyone with this can forge a
# valid download link. Generate your own the same way as JWT_SECRET:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ATTACHMENT_SIGNING_SECRET=<at least 32 random characters>

# Sign in with Google / GitHub (ADR 0042). Optional: a provider's buttons appear only when BOTH of its values are set.
# Redirect URLs to register in each console (APP_URL + the path; in dev the Vite proxy forwards /api to the API):
#   Google (Cloud console > APIs & Services > Credentials > OAuth client, type "Web application"):
#     http://localhost:5173/api/v1/auth/oauth/google/callback
#   GitHub (Settings > Developer settings > OAuth Apps):
#     http://localhost:5173/api/v1/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Development only: try the Google/GitHub buttons and the whole flow WITHOUT real credentials. Both buttons appear and sign you in
# as a made-up person (fake.person@example.com). Replaces the real providers while on; the API refuses to start with it in production.
# OAUTH_FAKE=true

# "Try the demo" (ADR 0044): a private, self-deleting copy of the demo organization per visitor, started from the landing page. OFF unless
# DEMO_ENABLED=true (turn it on on purpose in production). A copy lives DEMO_TTL_MINUTES; at most DEMO_MAX_ACTIVE copies are alive at once.
# DEMO_ENABLED=true
# DEMO_TTL_MINUTES=120
# DEMO_MAX_ACTIVE=40

# Production (ADR 0046). Leave these out locally. On Render: TRUST_PROXY=3 (measured, ADR 0051; not 1), SERVE_WEB=true, RUN_MIGRATIONS=true, NODE_ENV=production.
# TRUST_PROXY: how many proxies are in front of the server (so rate limits see the visitor). SERVE_WEB: serve the built web app from the API
# process (needs `pnpm build` first; WEB_DIST_DIR overrides where it was built). RUN_MIGRATIONS: update the database schema at start.
# TRUST_PROXY=3
# SERVE_WEB=true
# RUN_MIGRATIONS=true

# First deploy on Render (ADR 0049; the real values live in render.yaml and Render's dashboard, never here).
# STORAGE_DRIVER: "local" (default) keeps uploads on disk under UPLOADS_DIR; "disabled" refuses uploads (a host with no persistent disk).
# DB_POOL_MAX: the most database connections the server opens (default 10; a free Neon database allows only so many).
# APP_URL may be left out on Render: the server uses Render's own RENDER_EXTERNAL_URL.
# STORAGE_DRIVER=disabled
# DB_POOL_MAX=10

# File storage (ADR 0053). STORAGE_DRIVER=local keeps files on disk under UPLOADS_DIR (development). "s3" keeps them in an S3-compatible bucket
# (Neon Object Storage on Render); all five S3_* values are then required. "disabled" refuses uploads.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://br-<branch>.storage.c-<n>.eu-central-1.aws.neon.tech
# S3_REGION=eu-central-1
# S3_BUCKET=flowdesk-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Error tracking (ADR 0055). Off unless a Sentry DSN is set. Only the server reports; no cookies, headers, bodies or people are sent.
# SENTRY_DSN=

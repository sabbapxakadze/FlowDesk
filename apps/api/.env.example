NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Postgres, dedicated least-privilege role (not the postgres superuser)
# — see docs/adr and CLAUDE.md. Create the role/db yourself locally; this
# file documents the shape, never a real credential.
DATABASE_URL=postgresql://flowdesk:<password>@localhost:5432/flowdesk_dev

# Only read by the API's test setup (apps/api/src/db/test-setup.ts), never
# by the running app. Separate database so tests never touch dev data.
TEST_DATABASE_URL=postgresql://flowdesk:<password>@localhost:5432/flowdesk_test

# Signs every access token — anyone with this can forge a valid login.
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<at least 32 random characters>

# Sign up at resend.com, create an API key. Their sandbox sends to your
# own account email with no domain verification needed — fine for local dev.
RESEND_API_KEY=<your resend api key>
EMAIL_FROM=onboarding@resend.dev
# The frontend's origin — verification/reset emails link back to the web
# app, not the API.
APP_URL=http://localhost:5173
